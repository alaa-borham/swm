# انسخ إلى .env أو عرّفها في خدمة التشغيل. لا تضع أسرارًا داخل الكود.
PORT=3000
HOST=0.0.0.0
# مجلد قاعدة البيانات والمرفقات والنسخ الاحتياطية
DATA_DIR=./data
# كلمة مرور المدير الأولى (تُستخدم مرة واحدة عند إنشاء القاعدة فقط)
ADMIN_PASSWORD=
# 1 عند التشغيل خلف HTTPS لإرسال الكوكي الآمن فقط
COOKIE_SECURE=1
# 1 عند التشغيل خلف وكيل عكسي (nginx) لقراءة عنوان العميل الصحيح
TRUST_PROXY=1
